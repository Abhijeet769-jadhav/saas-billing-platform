# =====================================================
# SaaS Billing Platform — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values
# Run: copy .env.example .env
# =====================================================

# ── Database ──────────────────────────────────────
# For Docker (local): use the values below as-is
# For Render: automatically injected from dashboard
DATABASE_URL=jdbc:postgresql://localhost:5432/saas_billing
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ── JWT Security ──────────────────────────────────
# IMPORTANT: Change this to a random 64-char string in production!
# Generate one with: openssl rand -hex 32
JWT_SECRET=9a4f2c8d3e7b1a5c8d6e3f2a1b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c

# ── Stripe Payment (Mock Mode) ────────────────────
# Leave as-is for mock/demo mode — no real charges
# For real Stripe: get keys from https://dashboard.stripe.com
STRIPE_API_KEY=sk_test_mock_key_51Osaasbillingplatformmockkey
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_key_for_testing

# ── Email / SMTP (Optional) ───────────────────────
# The app works without this — emails will just fail silently
# For Gmail: use App Password (not your real password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Frontend API URL ──────────────────────────────
# Leave empty for local dev (Vite proxy handles /api)
# For Render: set to your backend URL e.g. https://saas-billing-backend.onrender.com
VITE_API_URL=
